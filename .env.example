# Cópia comitável do `.env.local`, só com os nomes — nenhum valor real aqui.
# Para rodar localmente: copie para `.env.local` e preencha.
# Em produção (Vercel): Settings → Environment Variables.

# Webhooks do CRM Chroma, uma por LP. A URL inteira é o segredo (ele vai na
# query string). Faltando uma, o lead daquela LP não chega ao CRM e fica só
# no log de erro para reenvio manual.
# LP01 → webhook "LPs amaan" (etapa novo contato)
CHROMA_WEBHOOK_LP1=
# LP02 → webhook "LPs amaan - sem doc" (etapa novo contato - sem doc)
CHROMA_WEBHOOK_LP2=

# Destino genérico opcional (automação/planilha). Recebe o lead das duas LPs
# no formato interno (`Lead`, em `validar.ts`), em paralelo ao CRM. Vazio:
# só o CRM recebe.
LEAD_WEBHOOK_URL=

# Meta Conversions API — token gerado no Gerenciador de Eventos (Pixel
# 1124238353883498 → Configurações → API de Conversões). Vazio: só o Pixel do
# navegador envia eventos.
META_CAPI_TOKEN=

# Opcional: código da aba "Eventos de teste". Preenchido, os eventos do
# servidor caem lá e não contam para as campanhas — apague depois de testar.
META_CAPI_TEST_CODE=
