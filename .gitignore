# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which documents the variable names and holds no values
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large video assets — serve from a CDN / Vercel Blob, not git
/public/*.mp4

# material bruto — renders, fotos originais, mockups, briefs e logos em alta.
# Ficam no disco como fonte (vídeos, peças), fora do git e do deploy: o site
# só usa as versões otimizadas de /public/fotos e os logos pequenos abaixo.
/public/*.png
!/public/logo-amaan-name-01.png
!/public/logo-amaan-name-03.png
!/public/logo-amaan-simbolo-dourado.png
/public/*.jpg
/public/*.JPG
/public/*.jpeg
/public/*.pdf
/public/*.svg
/public/essencia.txt
/public/fabhricio.webp

# lead / contact data — sensitive, must never be committed
/public/*.xls
/public/*.xlsx
